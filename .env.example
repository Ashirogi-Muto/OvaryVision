# Environment Variables Example for OvaryVision
# Copy this file to .env and populate with your credentials.
# NEVER commit .env to version control!

# Project Root & Logging
OVARYVISION_PROJECT_ROOT=.
OVARYVISION_LOG_DIR=logs
OVARYVISION_LOG_LEVEL=INFO

# Data Paths
OVARYVISION_DATA_DIR=data
OVARYVISION_MMOTU_RAW_DIR=data/raw/mmotu
OVARYVISION_OVATUS_RAW_DIR=data/raw/ovatus_v1

# Compute Environment (oci, colab, kaggle, local_gpu)
OVARYVISION_PLATFORM=oci
OVARYVISION_DEVICE=cpu

# Optional External Cloud Sync (for Colab / Kaggle runs)
# WANDB_API_KEY=
# KAGGLE_USERNAME=
# KAGGLE_KEY=

